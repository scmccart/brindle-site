---
import GithubMark from "@/components/site/github-mark.astro"
import Logo from "@/components/site/logo.astro"
import { release } from "@/data/release"
---

<header class="mx-auto flex h-20 max-w-[1200px] items-center justify-between gap-6 px-5 sm:px-10">
  <a
    href="#top"
    class="flex min-h-11 items-center gap-2.5 text-[19px] font-bold tracking-[-0.02em] no-underline"
  >
    <Logo class="size-[22px]" />
    Brindle
  </a>
  <nav
    aria-label="Main"
    class="flex items-center gap-7 text-[15px] font-medium"
  >
    <a href="#features" class="no-underline max-sm:hidden">
      Features
    </a>
    <a href="#install" class="no-underline">
      Install
    </a>
    <a
      href={release.repo}
      class="inline-flex h-11 items-center gap-2 no-underline"
    >
      <GithubMark class="size-[18px]" />
      GitHub
    </a>
  </nav>
</header>
